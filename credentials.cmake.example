# Copy this file to credentials.cmake and fill in your Slack app credentials.
# credentials.cmake is gitignored — never commit the real values. Each user
# can also paste their own keys in Settings → System, which take precedence.
set(MSGA_CLIENT_ID     "")
set(MSGA_CLIENT_SECRET "")
set(MSGA_XAPP          "")
# GIPHY API key for the GIF picker in the message composer. Optional — leave
# empty and each user can paste their own key in Settings → System.
# Get one at https://developers.giphy.com/dashboard/ (free keys allow 100
# calls/hour, which the picker caches aggressively to stay under).
set(MSGA_GIPHY_KEY "")
# macOS: the identity msga.app is signed with (a name or SHA-1 from
# `security find-identity -v -p codesigning`). Empty = ad-hoc, which makes the
# keychain ask again after every build.
set(MSGA_CODESIGN_IDENTITY "")
